{
  "name": "@drugrep/engine-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Reads a DrugRep engine run export, computes per layer hashes and the Poseidon predictions root, and anchors the run on Solana.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": "./src/index.ts", "./fixtures/*": "./fixtures/*" },
  "scripts": {
    "commit": "tsx src/cli.ts",
    "hash": "tsx src/cli.ts --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drugrep/sdk": "workspace:*",
    "@anchor-lang/core": "1.2.1",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": { "vitest": "5.0.3" }
}
