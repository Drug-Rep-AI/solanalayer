{
  "name": "@drugrep/app",
  "version": "0.1.0",
  "private": true,
  "description": "DrugRep Proof Layer web app (Next.js, Solana devnet).",
  "type": "module",
  "scripts": {
    "prepare-zk": "node scripts/copy-zk.mjs",
    "dev": "node scripts/copy-zk.mjs && next dev",
    "build": "node scripts/copy-zk.mjs && next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.1",
    "@drugrep/engine-bridge": "workspace:*",
    "@drugrep/sdk": "workspace:*",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.40",
    "@solana/web3.js": "1.99.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0"
  }
}
